DATABASE_URL=postgresql://bear360:bear360@localhost:5432/bear360?schema=public
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=change-me-access-dev-only
JWT_REFRESH_SECRET=change-me-refresh-dev-only
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
PORT=3001
CORS_ORIGIN=http://localhost:5173

# Optional: real OTP email (Gmail app password). Without these, API returns demoCode 1234.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Bear360
# Optional override; defaults to SMTP_USER
# SMTP_FROM=

# Razorpay Subscriptions (SaaS billing)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Optional fixed plan ids; otherwise API auto-creates ₹999 / ₹2499 monthly plans
RAZORPAY_PLAN_BASIC=
RAZORPAY_PLAN_PROFESSIONAL=
